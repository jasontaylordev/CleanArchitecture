{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/bootstrap-scope.schema.json",
  "title": "Architecture bootstrap scope",
  "description": "Declares local and cross-repository sources from which architecture evidence may be collected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sources"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "const": "primary"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "access",
        "ref",
        "role",
        "include",
        "exclude"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "access": {
          "type": "string",
          "enum": [
            "local",
            "github_app"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "supporting"
          ]
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}