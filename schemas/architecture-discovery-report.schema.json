{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture discovery report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sources",
    "observations",
    "contradictions",
    "unknowns"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "configured_ref", "commit", "role"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "configured_ref": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "role": {
            "enum": ["primary", "supporting"]
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "statement",
          "confidence",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OBS-[0-9]{3,}$"
          },
          "category": {
            "enum": [
              "driver",
              "context",
              "component",
              "interface",
              "data",
              "security",
              "deployment",
              "operations",
              "decision"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": ["high", "medium", "low"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "commit", "path"],
              "properties": {
                "repository": {
                  "type": "string"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CON-[0-9]{3,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UNK-[0-9]{3,}$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}