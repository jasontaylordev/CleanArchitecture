{
  "$$schema": "http://json-schema.org/draft-07/schema#",
  "$$id": "https://schemas.example.invalid/ai-sdlc/work-packet.schema.json",
  "title": "Jira Work Packet",
  "description": "Normalized and evidence-backed engineering request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "version",
    "issue",
    "repository_baselines",
    "normalization",
    "problem",
    "desired_outcome",
    "scope",
    "acceptance_criteria",
    "non_functional_requirements",
    "dependencies",
    "architecture_hints",
    "evidence",
    "assumptions",
    "conflicts",
    "open_questions",
    "processing_blockers",
    "readiness"
  ],
  "properties": {
    "artifact_type": {
      "const": "work-packet"
    },
    "version": {
      "const": "1.0"
    },
    "issue": {
      "$$ref": "#/definitions/issue"
    },
    "repository_baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$$ref": "#/definitions/repositoryBaseline"
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "generated_at",
        "generated_by"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready-for-architecture",
            "needs-clarification",
            "blocked"
          ]
        },
        "generated_at": {
          "$$ref": "#/definitions/dateTime"
        },
        "generated_by": {
          "$$ref": "#/definitions/actor"
        },
        "source_updated_at": {
          "oneOf": [
            {
              "$$ref": "#/definitions/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/nonEmpty"
          }
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "affected_users_or_systems",
        "business_impact",
        "evidence_ids"
      ],
      "properties": {
        "statement": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "affected_users_or_systems": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/nonEmpty"
          }
        },
        "business_impact": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "urgency_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "$$ref": "#/definitions/evidenceIds"
        }
      }
    },
    "desired_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "success_indicators",
        "evidence_ids"
      ],
      "properties": {
        "statement": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "business_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_indicators": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/nonEmpty"
          }
        },
        "evidence_ids": {
          "$$ref": "#/definitions/evidenceIds"
        }
      }
    },
    "current_behavior": {
      "oneOf": [
        {
          "$$ref": "#/definitions/behavior"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_behavior": {
      "oneOf": [
        {
          "$$ref": "#/definitions/behavior"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded",
        "affected_products",
        "repository_hints",
        "component_hints"
      ],
      "properties": {
        "included": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$$ref": "#/definitions/scopeItem"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/scopeItem"
          }
        },
        "affected_products": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/nonEmpty"
          }
        },
        "repository_hints": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/nonEmpty"
          }
        },
        "component_hints": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/nonEmpty"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$$ref": "#/definitions/acceptanceCriterion"
      }
    },
    "bug_details": {
      "oneOf": [
        {
          "$$ref": "#/definitions/bugDetails"
        },
        {
          "type": "null"
        }
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "$$ref": "#/definitions/requirement"
      }
    },
    "non_functional_requirements": {
      "type": "array",
      "items": {
        "$$ref": "#/definitions/nonFunctionalRequirement"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$$ref": "#/definitions/dependency"
      }
    },
    "test_expectations": {
      "type": "array",
      "items": {
        "$$ref": "#/definitions/testExpectation"
      }
    },
    "architecture_hints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_hint",
        "referenced_documents",
        "referenced_sections",
        "referenced_decisions",
        "migration_indicators"
      ],
      "properties": {
        "lifecycle_hint": {
          "enum": [
            "baseline",
            "transition",
            "target",
            "mixed",
            "unknown"
          ]
        },
        "referenced_documents": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/nonEmpty"
          }
        },
        "referenced_sections": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/identifier"
          }
        },
        "referenced_decisions": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/identifier"
          }
        },
        "migration_indicators": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/nonEmpty"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$$ref": "#/definitions/evidence"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$$ref": "#/definitions/assumption"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$$ref": "#/definitions/conflict"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$$ref": "#/definitions/question"
      }
    },
    "processing_blockers": {
      "type": "array",
      "items": {
        "$$ref": "#/definitions/nonEmpty"
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_clear",
        "scope_clear",
        "criteria_testable",
        "required_evidence_available",
        "blocking_items_resolved",
        "ready_for_architecture",
        "summary"
      ],
      "properties": {
        "outcome_clear": {
          "type": "boolean"
        },
        "scope_clear": {
          "type": "boolean"
        },
        "criteria_testable": {
          "type": "boolean"
        },
        "required_evidence_available": {
          "type": "boolean"
        },
        "blocking_items_resolved": {
          "type": "boolean"
        },
        "ready_for_architecture": {
          "type": "boolean"
        },
        "summary": {
          "$$ref": "#/definitions/nonEmpty"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "normalization": {
            "properties": {
              "status": {
                "const": "ready-for-architecture"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "readiness": {
            "properties": {
              "outcome_clear": {
                "const": true
              },
              "scope_clear": {
                "const": true
              },
              "criteria_testable": {
                "const": true
              },
              "required_evidence_available": {
                "const": true
              },
              "blocking_items_resolved": {
                "const": true
              },
              "ready_for_architecture": {
                "const": true
              }
            }
          },
          "open_questions": {
            "not": {
              "contains": {
                "properties": {
                  "blocking": {
                    "const": true
                  },
                  "status": {
                    "const": "open"
                  }
                },
                "required": [
                  "blocking",
                  "status"
                ]
              }
            }
          },
          "conflicts": {
            "not": {
              "contains": {
                "properties": {
                  "blocking": {
                    "const": true
                  },
                  "status": {
                    "const": "open"
                  }
                },
                "required": [
                  "blocking",
                  "status"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "normalization": {
            "properties": {
              "status": {
                "enum": [
                  "needs-clarification",
                  "blocked"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "readiness": {
            "properties": {
              "ready_for_architecture": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$$ref": "#/definitions/identifier"
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "service"
          ]
        },
        "name": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "jira_type",
        "engineering_category",
        "status",
        "source_url"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$$"
        },
        "title": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "jira_type": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "engineering_category": {
          "enum": [
            "feature",
            "bug",
            "refactoring",
            "investigation",
            "maintenance",
            "infrastructure",
            "documentation",
            "migration",
            "security-remediation",
            "unknown"
          ]
        },
        "status": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "parent_key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$$"
        },
        "linked_issue_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$$"
          }
        }
      }
    },
    "repositoryBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "root",
        "commit"
      ],
      "properties": {
        "name": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "root": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40,64}$$"
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "evidence_ids"
      ],
      "properties": {
        "description": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "evidence_ids": {
          "$$ref": "#/definitions/evidenceIds"
        }
      }
    },
    "scopeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "evidence_ids"
      ],
      "properties": {
        "description": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "evidence_ids": {
          "$$ref": "#/definitions/evidenceIds"
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "status",
        "verification",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "$$ref": "#/definitions/identifier"
        },
        "description": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "status": {
          "enum": [
            "confirmed",
            "draft"
          ]
        },
        "verification": {
          "enum": [
            "automated-test",
            "manual-test",
            "inspection",
            "monitoring",
            "demonstration",
            "unknown"
          ]
        },
        "evidence_ids": {
          "$$ref": "#/definitions/evidenceIds"
        }
      }
    },
    "bugDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reproduction_steps",
        "preconditions",
        "environment",
        "frequency",
        "error_messages",
        "workaround",
        "suspected_root_cause"
      ],
      "properties": {
        "reproduction_steps": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/nonEmpty"
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/nonEmpty"
          }
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "frequency": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_messages": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/nonEmpty"
          }
        },
        "workaround": {
          "type": [
            "string",
            "null"
          ]
        },
        "suspected_root_cause": {
          "type": [
            "string",
            "null"
          ]
        },
        "root_cause_status": {
          "enum": [
            "not-provided",
            "unconfirmed",
            "confirmed"
          ]
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "mandatory",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "$$ref": "#/definitions/identifier"
        },
        "description": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "mandatory": {
          "type": "boolean"
        },
        "evidence_ids": {
          "$$ref": "#/definitions/evidenceIds"
        }
      }
    },
    "nonFunctionalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "description",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "$$ref": "#/definitions/identifier"
        },
        "category": {
          "enum": [
            "security",
            "privacy",
            "auditability",
            "performance",
            "availability",
            "resilience",
            "scalability",
            "accessibility",
            "observability",
            "maintainability",
            "compatibility",
            "retention",
            "regulatory",
            "other"
          ]
        },
        "description": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "status": {
          "enum": [
            "confirmed",
            "draft"
          ]
        },
        "evidence_ids": {
          "$$ref": "#/definitions/evidenceIds"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "relationship",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "$$ref": "#/definitions/identifier"
        },
        "type": {
          "enum": [
            "repository",
            "service",
            "library",
            "team",
            "vendor",
            "environment",
            "decision",
            "issue",
            "other",
            "unknown"
          ]
        },
        "name": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "relationship": {
          "enum": [
            "requires",
            "blocks",
            "blocked-by",
            "consumes",
            "provides",
            "coordinates-with"
          ]
        },
        "status": {
          "enum": [
            "available",
            "pending",
            "blocked",
            "unknown"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "$$ref": "#/definitions/evidenceIds"
        }
      }
    },
    "testExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "level",
        "acceptance_criteria_ids",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "$$ref": "#/definitions/identifier"
        },
        "description": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "level": {
          "enum": [
            "unit",
            "component",
            "integration",
            "contract",
            "architecture",
            "security",
            "performance",
            "end-to-end",
            "smoke",
            "regression",
            "manual",
            "unknown"
          ]
        },
        "acceptance_criteria_ids": {
          "type": "array",
          "items": {
            "$$ref": "#/definitions/identifier"
          }
        },
        "evidence_ids": {
          "$$ref": "#/definitions/evidenceIds"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "location",
        "summary",
        "classification",
        "confidence",
        "verified"
      ],
      "properties": {
        "id": {
          "$$ref": "#/definitions/identifier"
        },
        "source": {
          "enum": [
            "jira-field",
            "jira-comment",
            "linked-issue",
            "attachment",
            "screenshot",
            "video",
            "log",
            "policy",
            "other"
          ]
        },
        "location": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "summary": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "classification": {
          "enum": [
            "fact",
            "reported-claim",
            "inference"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "impact_if_false",
        "status"
      ],
      "properties": {
        "id": {
          "$$ref": "#/definitions/identifier"
        },
        "statement": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "impact_if_false": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "status": {
          "enum": [
            "unverified",
            "validated",
            "invalidated"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "evidence_ids",
        "impact",
        "blocking",
        "status"
      ],
      "properties": {
        "id": {
          "$$ref": "#/definitions/identifier"
        },
        "description": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$$ref": "#/definitions/identifier"
          }
        },
        "impact": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "blocking": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "accepted"
          ]
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "reason",
        "blocking",
        "status"
      ],
      "properties": {
        "id": {
          "$$ref": "#/definitions/identifier"
        },
        "question": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "reason": {
          "$$ref": "#/definitions/nonEmpty"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "open",
            "answered",
            "deferred",
            "cancelled"
          ]
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/identifier"
          }
        }
      }
    }
  }
}